<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.gomes.garrison</string>
	</array>
	<!-- Remote notifications. TestFlight/App Store builds use the production
	     APNs environment. Requires Push Notifications enabled on the App ID +
	     a provisioning profile that includes it. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Time Sensitive Notifications: lets pushes break through Focus modes and
	     Scheduled Summary (paired with apns interruption-level: time-sensitive).
	     Requires the matching capability on the App ID. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
