  "continuations": [
    {
      "id": "cont-plan",
      "when": "plan",
      "then": [
        {
          "verb": "ask",
          "arg": "Implement this plan?"
        },
        {
          "verb": "route",
          "arg": "cc-sonnet-med"
        }
      ]
    },
    {
      "id": "cont-report",
      "when": "report",
      "then": [
        {
          "verb": "store"
        },
        {
          "verb": "ask",
          "arg": "Act on this report?"
        }
