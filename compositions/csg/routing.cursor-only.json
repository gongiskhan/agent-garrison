  "tiers": [
    "T0-trivial",
    "T1-standard",
    "T2-deep"
  ],
  "tierDefinitions": {
    "T0-trivial": "A one-shot answer or a single mechanical edit: a rename, a typo, a fact lookup, a one-line config tweak. No multi-file reasoning, no design choices.",
    "T1-standard": "Ordinary day-to-day work: a bounded feature, a localized bug fix, a focused refactor, a normal review. Some reasoning across a few files; outcome is checkable by a test.",
    "T2-deep": "High-stakes or wide-blast-radius work: architecture, a tricky bug with unclear cause, a security-sensitive change, a multi-subsystem migration. Warrants the strongest model, full gates, and recorded evidence."
  },
  "providers": [
    {
      "id": "anthropic-plan",
      "kind": "anthropic-plan",
      "baseUrl": null,
      "notes": "Max OAuth, no base URL, no key"
    },
    {
      "id": "anthropic",
      "kind": "anthropic-plan",
      "baseUrl": null,
      "notes": "agent-sdk id for the Anthropic Max OAuth endpoint"
    },
    {
      "id": "deepseek",
      "kind": "cloud-oss",
      "baseUrl": "https://api.deepseek.com/anthropic",
      "vaultKey": "DEEPSEEK_API_KEY"
    },
    {
      "id": "zai-glm",
      "kind": "cloud-oss",
      "baseUrl": "https://api.z.ai/api/anthropic",
      "vaultKey": "ZAI_API_KEY"
    }
  ],
  "exceptions": [
    {
      "id": "ex-secrets",
      "when": "the prompt involves secrets, credentials, auth tokens, or the vault",
      "target": "cursor-codex"
    },
    {
      "id": "ex-automation-vision-adversarial",
      "when": "caller-asserted: an internal automation vision turn requests an independent adversarial verdict",
      "target": "cursor-opus"
    },
    {
      "id": "ex-automation-vision",
      "when": "caller-asserted: an internal automation vision turn must inspect a local browser screenshot",
      "target": "cursor-codex"
    },
    {
      "id": "ex-drill-curation",
      "when": "caller-asserted: Drill Spotter evidence curation, batch-judging captured frames into the Debrief reel",
      "target": "cursor-codex"
    },
    {
      "id": "ex-image",
      "when": "the prompt asks to generate, edit, or analyze an image",
      "target": "cursor-auto"
    },
    {
      "id": "ex-video",
      "when": "the prompt asks to generate or edit a video",
      "target": "cursor-auto"
