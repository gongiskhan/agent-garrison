{
  "activeProfile": "balanced",
  "computeLadder": [
    "cc-haiku-low",
    "cc-sonnet-med",
    "cc-opus-high"
  ],
  "continuations": [
    {
      "id": "cont-plan",
      "then": [
        {
          "arg": "Implement this plan?",
          "verb": "ask"
        },
        {
          "arg": "cc-sonnet-med",
          "verb": "route"
        }
      ],
      "when": "plan"
    },
    {
      "id": "cont-report",
      "then": [
        {
          "verb": "store"
        },
        {
          "arg": "Act on this report?",
          "verb": "ask"
        }
      ],
      "when": "report"
    }
  ],
  "coordination": {
    "enabled": true,
    "exclusiveLeases": [
      "apm.lock.yaml",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock"
    ],
    "fences": {
      "enabled": true,
      "trailer": "Garrison-Card"
    },
    "leaseTtlMinutes": 60,
    "serializeWhenUnavailable": true,
    "thresholds": {
      "heavyFiles": 3,
      "heavyRatio": 0.5
    }
  },
  "defaultFlow": "fix",
  "discipline": {
    "T0-trivial": {
      "distribution": "none",
      "evidence": "none",
      "review": "none",
      "testing": "none"
    },
    "T1-standard": {
      "distribution": "none",
      "evidence": "text",
      "review": "self-review",
      "testing": "tests"
    },
    "T2-deep": {
      "distribution": "link",
      "evidence": "video",
      "review": "review-by:default",
      "testing": "full-gates"
    }
  },
  "exceptions": [
    {
      "id": "ex-build-schema",
      "targetId": "cc-sonnet-med",
      "when": "write or define a data model, schema, struct, type, or interface"
    },
    {
      "id": "ex-build-helper",
      "targetId": "cc-haiku-low",
      "when": "a small, simple, quick, or trivial helper or utility function"
    },
    {
      "id": "ex-build-core",
      "targetId": "cc-opus-high",
      "when": "implement a complex core algorithm or the main non-trivial logic"
    },
    {
      "id": "ex-review",
      "targetId": "cc-sonnet-med",
      "when": "review code for correctness bugs or quality"
    },
    {
      "id": "ex-fixes",
      "targetId": "cc-sonnet-med",
      "when": "implement, apply, or make code-review fixes"
    },
    {
      "id": "ex-test",
      "targetId": "cc-sonnet-med",
      "when": "write tests or a test suite for code"
    },
    {
      "id": "automation-vision",
      "targetId": "cc-sonnet-med",
      "when": "caller-asserted (matchedException) by the automations vision route - live vision resolution; the image matrix cell routes to sec-gemini which is unauthenticated on this box"
    },
    {
      "id": "automation-vision-drill",
      "targetId": "cc-sonnet-med",
      "when": "caller-asserted (matchedException) - Drill run vision/judge calls"
    },
    {
      "id": "automation-vision-drill-adversarial",
      "targetId": "cc-opus-high",
      "when": "caller-asserted (matchedException) - blind adversarial Drill pass on a DIFFERENT model than the normal pass (R12)"
    },
    {
      "id": "ex-automation-vision",
      "targetId": "cc-sonnet-med",
      "when": "caller-asserted (matchedException) by the automations vision route since 30e5545 - live vision resolution (the legacy automation-vision* ids above stay for older callers; without this entry the call falls through to the unauthenticated sec-gemini image row)"
    },
    {
      "id": "ex-automation-vision-adversarial",
      "targetId": "cc-opus-high",
      "when": "caller-asserted (matchedException) - blind adversarial Drill pass on a DIFFERENT model than the normal pass (R12)"
    },
    {
      "id": "ex-drill-curation",
      "targetId": "cc-haiku-low",
      "when": "caller-asserted (matchedException) - Drill Spotter evidence curation: batch keep/drop + annotation judging of captured frames (Debrief reel) - retargeted 2026-08-06: batch curation on the shared cc-sonnet-med warm session starved interactive verify/auth-probe turns for ~an hour (300-frame backlog); haiku triage runs on its OWN warm session and is per-batch fast"
    }
  ],
  "flows": {
    "automation": {
      "cluster": "C12 - recurring scheduled work",
      "defaultLevel": 2,
      "description": "Author, run and verify something that recurs without being asked, including the Cortex API path.",
      "examples": [
        "Morning briefing",
        "Ekoa-code: Apify Actor",
        "Verificar sincronizacao de memorias Garrison vs Omi"
      ],
      "levels": {
        "1": {
          "definitionOfDone": "The automation ran and its result is recorded.",
          "duties": [
            "ops"
          ],
          "evidence": "logs"
        },
        "2": {
          "definitionOfDone": "The automation exists, runs on its trigger, and a test proves it does what it claims.",
          "duties": [
            "plan",
            "implement",
            "test"
          ],
          "evidence": "logs"
        },
        "3": {
          "definitionOfDone": "As level 2, plus a review of the failure handling and a checked definition of done.",
          "duties": [
            "plan",
            "implement",
            "test",
            "review",
            "validate"
          ],
          "evidence": "text"
        }
      }
    },
    "chore": {
      "cluster": "C13/C14 - maintenance + test upkeep (50 chore + 44 test commits)",
      "defaultLevel": 1,
      "description": "Mechanical upkeep: dependency bumps, cleanups, dead-code removal, repetitive operational work. Shares a shape with `fix` at level 1 but is the prime automation candidate, so a recurring chore is a signal to build an automation instead.",
      "examples": [
        "web-channel: retire legacy-voice.tsx (dead code)",
        "Correr a bateria de testes automatizados completa"
      ],
      "levels": {
        "1": {
          "definitionOfDone": "The upkeep is applied and the suite is still green.",
          "duties": [
            "implement",
            "test"
          ],
          "evidence": "logs"
        },
        "2": {
          "definitionOfDone": "As level 1, plus a review that the cleanup removed nothing load-bearing.",
          "duties": [
            "implement",
            "test",
            "review"
          ],
          "evidence": "logs"
        },
        "3": {
          "definitionOfDone": "As level 2, with the blast radius established first.",
          "duties": [
            "plan",
            "implement",
            "test",
            "review",
            "validate"
          ],
          "evidence": "text"
        }
      }
    },
    "discussion": {
      "cluster": "C4 - discussion / scoping",
      "defaultLevel": 1,
      "description": "Thinking, not executing. Level 1 is conversation with no artefact; level 2 adds research and a written brief.",
      "examples": [
        "Let's talk this work item through before it goes to planning",
        "queria falar sobre a feature do assistente do ekoa (nova versao) nas apps"
      ],
      "levels": {
        "1": {
          "definitionOfDone": "The question is answered or the decision is made. No artefact, no board traffic beyond the Discuss card.",
          "duties": [
            "discuss"
          ],
          "evidence": "none"
        },
        "2": {
          "definitionOfDone": "A written brief exists that someone who was not in the conversation could act on.",
          "duties": [
            "discuss",
            "research",
            "writing"
          ],
          "evidence": "text"
        },
        "3": {
          "definitionOfDone": "As level 2, plus the brief has been argued against before it was accepted.",
          "duties": [
            "discuss",
            "research",
            "writing",
            "review"
          ],
          "evidence": "text",
          "pins": {
            "review": 3
          }
        }
      }
    },
    "docs": {
      "cluster": "C9 - docs / prose (134 docs commits)",
      "defaultLevel": 1,
      "description": "Prose: documentation, site copy, a written answer. No runtime behaviour changes.",
      "examples": [
        "Fazer alteracao de texto no site do ekoa",
        "https://www.togai.pt/novidades"
      ],
      "levels": {
        "1": {
          "definitionOfDone": "The text is written and in place.",
          "duties": [
            "writing"
          ],
          "evidence": "text"
        },
        "2": {
          "definitionOfDone": "As level 1, plus a read for accuracy.",
          "duties": [
            "writing",
            "review"
          ],
          "evidence": "text"
        },
        "3": {
          "definitionOfDone": "As level 2, plus sources checked and an adversarial read.",
          "duties": [
            "research",
            "writing",
            "review",
            "adversarial-review"
          ],
          "evidence": "text"
        }
      }
    },
    "feature": {
      "cluster": "C2/C3 - feature work + large brief-driven builds (218 feat commits)",
      "defaultLevel": 2,
      "description": "New behaviour in a project, from a bounded addition up to a whole brief. Level 3 is the full gated pipeline with adversarial passes and a walkthrough.",
      "examples": [
        "Kanban Loop: scheduling support for dated human and agent tasks",
        "on ekoa-code move the Pedidos into a tab in the settings area",
        "Execute BRIEF-DRILL-V1.md end to end: build the Drill fitting"
      ],
      "levels": {
        "1": {
          "definitionOfDone": "It works and the tests are green.",
          "duties": [
            "implement",
            "test"
          ],
          "evidence": "logs"
        },
        "2": {
          "definitionOfDone": "Planned before built, reviewed after, and the definition of done is checked rather than asserted.",
          "duties": [
            "plan",
            "implement",
            "test",
            "review",
            "validate"
          ],
          "evidence": "text"
        },
        "3": {
          "definitionOfDone": "As level 2, plus a decorrelated cross-model review, an independent test pass, a UX judgement and a walkthrough video.",
          "duties": [
            "plan",
            "implement",
            "test",
            "review",
            "adversarial-review",
            "adversarial-test",
            "ux-qa",
            "walkthrough",
            "validate",
            "report"
          ],
          "evidence": "video",
          "pins": {
            "adversarial-review": 3,
            "adversarial-test": 3
          }
        }
      }
    },
    "fix": {
      "cluster": "C1 - small fix / defect on a live app (280 fix commits in 4 weeks)",
      "defaultLevel": 1,
      "description": "A defect in something that already works. The dominant shape of real work and the one most likely to be done in a raw session instead, so level 1 stays cheap and fast.",
      "examples": [
        "Drill fix: chat - 1 finding (Aug 7, 18:21)",
        "the drill run results on garrison keeps flacking with scroll",
        "dont show the same message with the card twice on the web channel"
      ],
      "levels": {
        "1": {
          "definitionOfDone": "The defect no longer reproduces and a committed test covers it.",
          "duties": [
            "implement",
            "test"
          ],
          "evidence": "logs"
        },
        "2": {
          "definitionOfDone": "As level 1, plus a review that read the diff.",
          "duties": [
            "implement",
            "test",
            "review"
          ],
          "evidence": "logs"
        },
        "3": {
          "definitionOfDone": "As level 2, plus a decorrelated review that agrees the cause was found, not just the symptom.",
          "duties": [
            "plan",
            "implement",
            "test",
            "review",
            "adversarial-review"
          ],
          "evidence": "text",
          "pins": {
            "adversarial-review": 3
          }
        }
      }
    },
    "image": {
      "cluster": "C8 - media production",
      "defaultLevel": 1,
      "description": "Produce or edit an image.",
      "examples": [
        "garrison: brand icon work",
        "Criar imagem de demonstracao"
      ],
      "levels": {
        "1": {
          "definitionOfDone": "The image exists and is in place.",
          "duties": [
            "image"
          ],
          "evidence": "none"
        },
        "2": {
          "definitionOfDone": "As level 1, plus a look at whether it is actually good.",
          "duties": [
            "image",
            "review"
          ],
          "evidence": "text"
        },
        "3": {
          "definitionOfDone": "As level 2, judged in the surface it will appear in.",
          "duties": [
            "plan",
            "image",
            "review",
            "ux-qa"
          ],
          "evidence": "text"
        }
      }
    },
    "ops": {
      "cluster": "C6 - ops / deploy",
      "defaultLevel": 2,
      "description": "Deploys, infrastructure, provisioning. Anything whose blast radius is the running system rather than the codebase.",
      "examples": [
        "deploy to production",
        "ssh-copy-id -i ~/.ssh/id_ed25519.pub ggomes@dev-madrid"
      ],
      "levels": {
        "1": {
          "definitionOfDone": "The operation completed and was verified.",
          "duties": [
            "ops"
          ],
          "evidence": "logs"
        },
        "2": {
          "definitionOfDone": "Planned before executed, and the result was checked rather than assumed.",
          "duties": [
            "plan",
            "ops",
            "validate"
          ],
          "evidence": "logs"
        },
        "3": {
          "definitionOfDone": "As level 2, plus a security-boundary review and a reported outcome.",
          "duties": [
            "plan",
            "ops",
            "security-review",
            "validate",
            "report"
          ],
          "evidence": "text",
          "pins": {
            "security-review": 3
          }
        }
      }
    },
    "personal": {
      "cluster": "C10 - personal admin (the manual half)",
      "defaultLevel": 1,
      "description": "A personal card that rides the board by hand. No agent duties at any level - kept because some things are just a note to self.",
      "examples": [
        "Comprar peixe",
        "Beber cafe",
        "Levar brinquedos para a piscina"
      ],
      "levels": {
        "1": {
          "definitionOfDone": "Marked done by hand.",
          "duties": [
            "other"
          ],
          "evidence": "none"
        }
      },
      "manual": true
    },
    "qa-sweep": {
      "cluster": "C7 - QA sweep -> batch fix (~8 cards, previously ZERO config support)",
      "defaultLevel": 2,
      "description": "Drive the whole app looking for defects, then fix what was found. Garrison's own shape: Drill produces a report, the report becomes a batch of fixes.",
      "examples": [
        "Correr um drill completo (Garrison) sobre o ekoa-code",
        "Drill batch fix (report 01KXQK2VYA4XXZH3P7B1BZ2XEX)",
        "Correr a bateria de testes automatizados completa no ekoa-code"
      ],
      "levels": {
        "1": {
          "definitionOfDone": "The sweep ran and its findings are recorded.",
          "duties": [
            "drill"
          ],
          "evidence": "logs"
        },
        "2": {
          "definitionOfDone": "The sweep ran and every finding is either fixed or explicitly triaged.",
          "duties": [
            "drill",
            "implement",
            "test"
          ],
          "evidence": "logs"
        },
        "3": {
          "definitionOfDone": "As level 2, plus a review of the fixes and a walkthrough proving the sweep is clean.",
          "duties": [
            "drill",
            "implement",
            "test",
            "review",
            "walkthrough"
          ],
          "evidence": "video"
        }
      }
    },
    "research": {
      "cluster": "C5 - research / investigation",
      "defaultLevel": 2,
      "description": "Find something out and write down what was found. Distinct from discussion: the output is a document, not a decision.",
      "examples": [
        "Uncaught TypeError: Cannot read properties of undefined (reading 'map')",
        "Novo apanhado de divergencias antigo->novo"
      ],
      "levels": {
        "1": {
          "definitionOfDone": "The question is answered in the reply.",
          "duties": [
            "research"
          ],
          "evidence": "none"
        },
        "2": {
          "definitionOfDone": "A document exists with the finding and its sources.",
          "duties": [
            "research",
            "writing"
          ],
          "evidence": "text"
        },
        "3": {
          "definitionOfDone": "As level 2, and the conclusion survived a review that checked the sources.",
          "duties": [
            "plan",
            "research",
            "writing",
            "review"
          ],
          "evidence": "text"
        }
      }
    },
    "task": {
      "cluster": "C10/C11 - personal admin + comms follow-up (~18 cards)",
      "defaultLevel": 1,
      "description": "Do one thing and be done: send it, post it, file it, look it up and act. Minimal ceremony and no unnecessary board traffic.",
      "examples": [
        "Cancelar tudo na vodafone excepto servico casa",
        "Ekoa: responder Luciana sobre sharepoint",
        "Follow up with Brazilian clinic on AI WhatsApp assistant requirements",
        "Start playing Queen on Spotify"
      ],
      "levels": {
        "1": {
          "definitionOfDone": "The thing was done.",
          "duties": [
            "other"
          ],
          "evidence": "none"
        },
        "2": {
          "definitionOfDone": "The thing was done and the outcome was reported back.",
          "duties": [
            "other",
            "report"
          ],
          "evidence": "text"
        },
        "3": {
          "definitionOfDone": "As level 2, with the steps agreed before anything irreversible happened.",
          "duties": [
            "plan",
            "other",
            "report"
          ],
          "evidence": "text"
        }
      }
    },
    "video": {
      "cluster": "C8 - media production",
      "defaultLevel": 2,
      "description": "Produce or edit a video.",
      "examples": [
        "Criar o primeiro video de demonstracao do Akoa"
      ],
      "levels": {
        "1": {
          "definitionOfDone": "The video exists.",
          "duties": [
            "video"
          ],
          "evidence": "logs"
        },
        "2": {
          "definitionOfDone": "Scripted before shot, and watched before shipped.",
          "duties": [
            "plan",
            "video",
            "review"
          ],
          "evidence": "video"
        },
        "3": {
          "definitionOfDone": "As level 2, judged against the audience it is for.",
          "duties": [
            "plan",
            "video",
            "review",
            "ux-qa",
            "report"
          ],
          "evidence": "video"
        }
      }
    }
  },
