{
  "activeProfile": "balanced",
  "computeLadder": [
    "cc-haiku-low",
    "cc-sonnet-med",
    "cc-opus-high"
  ],
  "continuations": [
    {
      "id": "cont-plan",
      "then": [
        {
          "arg": "Implement this plan?",
          "verb": "ask"
        },
        {
          "arg": "cc-sonnet-med",
          "verb": "route"
        }
      ],
      "when": "plan"
    },
    {
      "id": "cont-report",
      "then": [
        {
          "verb": "store"
        },
        {
          "arg": "Act on this report?",
          "verb": "ask"
        }
      ],
      "when": "report"
    }
  ],
  "coordination": {
    "enabled": true,
    "exclusiveLeases": [
      "apm.lock.yaml",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock"
    ],
    "fences": {
      "enabled": true,
      "trailer": "Garrison-Card"
    },
    "leaseTtlMinutes": 60,
    "serializeWhenUnavailable": true,
    "thresholds": {
      "heavyFiles": 3,
      "heavyRatio": 0.5
    }
  },
  "defaultFlow": "full-feature",
  "discipline": {
    "T0-trivial": {
      "distribution": "none",
      "evidence": "none",
      "review": "none",
      "testing": "none"
    },
    "T1-standard": {
      "distribution": "none",
      "evidence": "text",
      "review": "self-review",
      "testing": "tests"
    },
    "T2-deep": {
      "distribution": "link",
      "evidence": "video",
      "review": "review-by:default",
      "testing": "full-gates"
    }
  },
  "exceptions": [
    {
      "id": "ex-build-schema",
      "targetId": "cc-sonnet-med",
      "when": "write or define a data model, schema, struct, type, or interface"
    },
    {
      "id": "ex-build-helper",
      "targetId": "cc-haiku-low",
      "when": "a small, simple, quick, or trivial helper or utility function"
    },
    {
      "id": "ex-build-core",
      "targetId": "cc-opus-high",
      "when": "implement a complex core algorithm or the main non-trivial logic"
    },
    {
      "id": "ex-review",
      "targetId": "cc-sonnet-med",
      "when": "review code for correctness bugs or quality"
    },
    {
      "id": "ex-fixes",
      "targetId": "cc-sonnet-med",
      "when": "implement, apply, or make code-review fixes"
    },
    {
      "id": "ex-test",
      "targetId": "cc-sonnet-med",
      "when": "write tests or a test suite for code"
    },
    {
      "id": "automation-vision",
      "targetId": "cc-sonnet-med",
      "when": "caller-asserted (matchedException) by the automations vision route - live vision resolution; the image matrix cell routes to sec-gemini which is unauthenticated on this box"
    },
    {
      "id": "automation-vision-drill",
      "targetId": "cc-sonnet-med",
      "when": "caller-asserted (matchedException) - Drill run vision/judge calls"
    },
    {
      "id": "automation-vision-drill-adversarial",
      "targetId": "cc-opus-high",
      "when": "caller-asserted (matchedException) - blind adversarial Drill pass on a DIFFERENT model than the normal pass (R12)"
    },
    {
      "id": "ex-automation-vision",
      "targetId": "cc-sonnet-med",
      "when": "caller-asserted (matchedException) by the automations vision route since 30e5545 - live vision resolution (the legacy automation-vision* ids above stay for older callers; without this entry the call falls through to the unauthenticated sec-gemini image row)"
    },
    {
      "id": "ex-automation-vision-adversarial",
      "targetId": "cc-opus-high",
      "when": "caller-asserted (matchedException) - blind adversarial Drill pass on a DIFFERENT model than the normal pass (R12)"
    },
    {
      "id": "ex-drill-curation",
      "targetId": "cc-sonnet-med",
      "when": "caller-asserted (matchedException) - Drill Spotter evidence curation: batch keep/drop + annotation judging of captured frames (Debrief reel)"
    }
  ],
