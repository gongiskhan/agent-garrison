  "flows": {
    "fix": {
      "description": "A defect in something that already works. The dominant shape of real work and the one most likely to be done in a raw session instead, so level 1 stays cheap and fast.",
      "cluster": "C1 - small fix / defect on a live app (280 fix commits in 4 weeks)",
      "examples": [
        "Drill fix: chat - 1 finding (Aug 7, 18:21)",
        "the drill run results on garrison keeps flacking with scroll",
        "dont show the same message with the card twice on the web channel"
      ],
      "defaultLevel": 1,
      "levels": {
        "1": {
          "duties": [
            "implement",
            "test"
          ],
          "definitionOfDone": "The defect no longer reproduces and a committed test covers it.",
          "evidence": "logs"
        },
        "2": {
          "duties": [
            "implement",
            "test",
            "review"
          ],
          "definitionOfDone": "As level 1, plus a review that read the diff.",
          "evidence": "logs"
        },
        "3": {
          "duties": [
            "plan",
            "implement",
            "test",
            "review",
            "adversarial-review"
          ],
          "pins": {
            "adversarial-review": 3
          },
          "definitionOfDone": "As level 2, plus a decorrelated review that agrees the cause was found, not just the symptom.",
          "evidence": "text"
        }
      }
    },
    "feature": {
      "description": "New behaviour in a project, from a bounded addition up to a whole brief. Level 3 is the full gated pipeline with adversarial passes and a walkthrough.",
      "cluster": "C2/C3 - feature work + large brief-driven builds (218 feat commits)",
      "examples": [
        "Kanban Loop: scheduling support for dated human and agent tasks",
        "on ekoa-code move the Pedidos into a tab in the settings area",
        "Execute BRIEF-DRILL-V1.md end to end: build the Drill fitting"
      ],
      "defaultLevel": 2,
      "levels": {
        "1": {
          "duties": [
            "implement",
            "test"
          ],
          "definitionOfDone": "It works and the tests are green.",
          "evidence": "logs"
        },
        "2": {
          "duties": [
            "plan",
            "implement",
            "test",
            "review",
            "validate"
          ],
          "definitionOfDone": "Planned before built, reviewed after, and the definition of done is checked rather than asserted.",
          "evidence": "text"
        },
        "3": {
          "duties": [
            "plan",
            "implement",
            "test",
            "review",
            "adversarial-review",
            "adversarial-test",
            "ux-qa",
            "walkthrough",
            "validate",
            "report"
          ],
          "pins": {
            "adversarial-review": 3,
            "adversarial-test": 3
          },
          "definitionOfDone": "As level 2, plus a decorrelated cross-model review, an independent test pass, a UX judgement and a walkthrough video.",
          "evidence": "video"
        }
      }
    },
    "discussion": {
      "description": "Thinking, not executing. Level 1 is conversation with no artefact; level 2 adds research and a written brief.",
      "cluster": "C4 - discussion / scoping",
      "examples": [
        "Let's talk this work item through before it goes to planning",
        "queria falar sobre a feature do assistente do ekoa (nova versao) nas apps"
      ],
      "defaultLevel": 1,
      "levels": {
        "1": {
          "duties": [
            "discuss"
          ],
          "definitionOfDone": "The question is answered or the decision is made. No artefact, no board traffic beyond the Discuss card.",
          "evidence": "none"
        },
        "2": {
          "duties": [
            "discuss",
            "research",
            "writing"
          ],
          "definitionOfDone": "A written brief exists that someone who was not in the conversation could act on.",
          "evidence": "text"
        },
        "3": {
          "duties": [
            "discuss",
            "research",
            "writing",
            "review"
          ],
          "pins": {
            "review": 3
          },
          "definitionOfDone": "As level 2, plus the brief has been argued against before it was accepted.",
          "evidence": "text"
        }
      }
    },
    "research": {
      "description": "Find something out and write down what was found. Distinct from discussion: the output is a document, not a decision.",
      "cluster": "C5 - research / investigation",
      "examples": [
        "Uncaught TypeError: Cannot read properties of undefined (reading 'map')",
        "Novo apanhado de divergencias antigo->novo"
      ],
      "defaultLevel": 2,
      "levels": {
        "1": {
          "duties": [
            "research"
          ],
          "definitionOfDone": "The question is answered in the reply.",
          "evidence": "none"
        },
        "2": {
          "duties": [
            "research",
            "writing"
          ],
          "definitionOfDone": "A document exists with the finding and its sources.",
          "evidence": "text"
        },
        "3": {
          "duties": [
            "plan",
            "research",
            "writing",
            "review"
          ],
          "definitionOfDone": "As level 2, and the conclusion survived a review that checked the sources.",
          "evidence": "text"
        }
      }
    },
    "qa-sweep": {
      "description": "Drive the whole app looking for defects, then fix what was found. Garrison's own shape: Drill produces a report, the report becomes a batch of fixes.",
      "cluster": "C7 - QA sweep -> batch fix (~8 cards, previously ZERO config support)",
      "examples": [
        "Correr um drill completo (Garrison) sobre o ekoa-code",
        "Drill batch fix (report 01KXQK2VYA4XXZH3P7B1BZ2XEX)",
        "Correr a bateria de testes automatizados completa no ekoa-code"
      ],
      "defaultLevel": 2,
      "levels": {
        "1": {
          "duties": [
            "drill"
          ],
          "definitionOfDone": "The sweep ran and its findings are recorded.",
          "evidence": "logs"
        },
        "2": {
          "duties": [
            "drill",
            "implement",
            "test"
          ],
          "definitionOfDone": "The sweep ran and every finding is either fixed or explicitly triaged.",
          "evidence": "logs"
        },
        "3": {
          "duties": [
            "drill",
            "implement",
            "test",
            "review",
            "walkthrough"
          ],
          "definitionOfDone": "As level 2, plus a review of the fixes and a walkthrough proving the sweep is clean.",
          "evidence": "video"
        }
      }
    },
    "task": {
      "description": "Do one thing and be done: send it, post it, file it, look it up and act. Minimal ceremony and no unnecessary board traffic.",
      "cluster": "C10/C11 - personal admin + comms follow-up (~18 cards)",
      "examples": [
        "Cancelar tudo na vodafone excepto servico casa",
        "Ekoa: responder Luciana sobre sharepoint",
        "Follow up with Brazilian clinic on AI WhatsApp assistant requirements",
        "Start playing Queen on Spotify"
      ],
      "defaultLevel": 1,
      "levels": {
        "1": {
          "duties": [
            "other"
          ],
          "definitionOfDone": "The thing was done.",
          "evidence": "none"
        },
        "2": {
          "duties": [
            "other",
            "report"
          ],
          "definitionOfDone": "The thing was done and the outcome was reported back.",
          "evidence": "text"
        },
        "3": {
          "duties": [
            "plan",
            "other",
            "report"
          ],
          "definitionOfDone": "As level 2, with the steps agreed before anything irreversible happened.",
          "evidence": "text"
        }
      }
    },
    "automation": {
      "description": "Author, run and verify something that recurs without being asked, including the Cortex API path.",
