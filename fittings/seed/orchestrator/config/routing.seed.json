{
  "version": 2,
  "activeProfile": "balanced",
  "primaryRuntime": "claude-code-runtime",
  "taskTypes": [
    "plan",
    "implement",
    "review",
    "adversarial-review",
    "test",
    "adversarial-test",
    "security-review",
    "ux-qa",
    "walkthrough",
