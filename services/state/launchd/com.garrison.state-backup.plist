<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.garrison.state-backup</string>
  <!-- macOS counterpart of garrison-state-backup.timer: hourly WAL-safe
       VACUUM INTO snapshots (the script keeps 24 hourly / 30 daily itself).
       The snapshot is the encrypted-at-rest DB; the master key stays in this
       machine's keychain, so a copied snapshot alone cannot decrypt secrets. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/varela/.local/node/bin/node</string>
    <string>scripts/backup.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/varela/.garrison-state/current</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/varela</string>
    <key>PATH</key><string>/Users/varela/.local/node/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/varela/.garrison-state/logs/backup.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/varela/.garrison-state/logs/backup.err.log</string>
</dict>
</plist>
