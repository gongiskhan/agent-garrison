# One-shot: hourly WAL-safe snapshot (VACUUM INTO). Paired with
# garrison-state-backup.timer. The daily variant ships off-box.

[Unit]
Description=Garrison state DB snapshot

[Service]
Type=oneshot
WorkingDirectory=%h/.garrison-state/current
ExecStart=/usr/bin/env node scripts/backup.mjs
Environment=PATH=/home/ggomes/.nvm/versions/node/v20.19.4/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
